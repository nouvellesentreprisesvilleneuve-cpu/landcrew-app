# LandCrew — variables d'environnement (toutes optionnelles)
#
# PORT : fourni automatiquement par Passenger (cPanel « Setup Node.js
# App »). En démarrage manuel, 3000 par défaut.
# PORT=3000
#
# LANDCREW_DB_PATH : chemin du fichier SQLite. Par défaut :
# <racine de l'application>/data/landcrew.db — ne PAS placer ce fichier
# dans public/ (il ne doit jamais être téléchargeable).
# LANDCREW_DB_PATH=/home/asel7953/landcrew-app/data/landcrew.db
