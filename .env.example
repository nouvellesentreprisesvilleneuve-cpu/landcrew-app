# LandCrew — variables d'environnement (toutes optionnelles)
#
# PORT : fourni automatiquement par Passenger (cPanel « Setup Node.js
# App »). En démarrage manuel, 3000 par défaut.
# PORT=3000
#
# LANDCREW_DB_PATH : chemin du fichier SQLite. Par défaut :
# <racine de l'application>/data/landcrew.db — ne PAS placer ce fichier
# dans public/ (il ne doit jamais être téléchargeable).
# LANDCREW_DB_PATH=/home/asel7953/landcrew-app/data/landcrew.db
#
# Assistant LandCrew (« Dis-le-moi ») — TOUTES optionnelles. Sans clé,
# l'assistant utilise son extracteur intégré gratuit (aucun coût).
# LANDCREW_AI_API_KEY : clé du fournisseur de modèle. Sa seule présence
# allume le moteur modèle ; en cas d'échec du modèle, l'extracteur
# intégré prend le relais. Ne jamais mettre une vraie clé dans ce
# fichier — la régler dans l'environnement du serveur (Render).
# LANDCREW_AI_API_KEY=
# LANDCREW_AI_MODEL : modèle utilisé (défaut : claude-haiku-4-5).
# LANDCREW_AI_MODEL=claude-haiku-4-5
# LANDCREW_AI_BASE_URL : si réglée, l'appel part en format compatible
# OpenAI vers <base>/chat/completions ; sinon, format Anthropic.
# LANDCREW_AI_BASE_URL=
